# Local server (defaults: 127.0.0.1:8000)
ASSISTANT_HOST=127.0.0.1
ASSISTANT_PORT=8000
ASSISTANT_PID_PATH=.data/assistant.pid
ASSISTANT_DATABASE_PATH=.data/assistant.sqlite3

# Model mode: deterministic is the offline default; ollama is opt-in.
ASSISTANT_MODEL_MODE=deterministic
ASSISTANT_SIMPLE_MODEL=local-small
ASSISTANT_COMPLEX_MODEL=local-reasoning
ASSISTANT_OLLAMA_ENDPOINT=http://localhost:11434/v1/chat/completions
ASSISTANT_OLLAMA_TIMEOUT_SECONDS=8
ASSISTANT_OLLAMA_GUARDIAN_MODEL=
ASSISTANT_OLLAMA_SIMPLE_MODEL=qwen3.5:4b
ASSISTANT_OLLAMA_COMPLEX_MODEL=qwen3.5:9b

# Chat tool planner: rules (offline default) or ollama (local function calling
# with the simple model; invalid proposals fall back to rules).
ASSISTANT_TOOL_PLANNER=rules

# Per-question/session guardrails
ASSISTANT_MAX_INPUT_TOKENS=2000
ASSISTANT_MAX_OUTPUT_TOKENS=300
ASSISTANT_MAX_CONVERSATION_TURNS=20
ASSISTANT_MAX_SESSION_COST_USD=0.05
ASSISTANT_MAX_TOOL_ATTEMPTS=8
ASSISTANT_REQUEST_EXPIRY_SECONDS=86400
